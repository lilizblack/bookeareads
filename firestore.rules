rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Current user's own data (legacy root users doc)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections of current user
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public Profile access via Collection Group
    // Needed for searching by @username accurately
    match /{path=**}/profile/{document} {
       allow read: if request.auth != null;
    }

    // Individual profile document fallback
    match /users/{userId}/profile/info {
       allow read: if request.auth != null;
    }

    // Friendships collection
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.requesterId);
      allow update: if request.auth != null && (request.auth.uid in resource.data.participants);
      allow delete: if request.auth != null && (request.auth.uid in resource.data.participants);
    }
    
    // Read the other user's public books
    match /users/{userId}/books/{bookId} {
      allow read: if request.auth != null;
    }
  }
}
